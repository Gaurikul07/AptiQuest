# server/.env (copy to server/.env)
PORT=4000
# Comma-separated list of allowed browser origins for CORS + Socket.IO
CLIENT_ORIGIN=http://localhost:5173
# Pause between a round's result screen and the next question (ms)
RESULT_PAUSE_MS=5000
MAX_PLAYERS=200
# DB_FILE=./data/aptiquest.db

# client/.env (only needed if the client is hosted separately from the server)
